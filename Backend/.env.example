# ==========================================================================
# Trading Jurnal V2 — Backend env namunasi
# Bu faylni .env ga nusxalab, qiymatlarni to'ldiring:
#   cp .env.example .env
# ❗ .env hech qachon git'ga qo'shilmaydi (.gitignore da).
# ==========================================================================

# Server porti (bo'sh qoldirilsa 5000 ishlatiladi)
PORT=

# MongoDB ulanish satri (Atlas yoki mahalliy mongod)
MONGO_URI=

# JWT imzolash kaliti — uzun va tasodifiy bo'lsin
# Yaratish: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Google Sign-In (faqat Client ID kerak — ID token frontendda olinadi)
GOOGLE_CLIENT_ID=

# --------------------------------------------------------------------------
# EMAIL — tasdiqlash va parol tiklash kodlari shu orqali yuboriladi
# --------------------------------------------------------------------------

# gmail (default) yoki brevo.
# Tanlangan provayder sozlanmagan bo'lsa kod SERVER KONSOLIGA chiqadi —
# lokal dev uchun hech qanday kalit kerak emas.
EMAIL_PROVIDER=gmail

# EMAIL_PROVIDER=gmail uchun.
# ❗ GMAIL_APP_PASSWORD oddiy Gmail paroli EMAS — Google hisobida
#    2FA yoqilgach yaratiladigan 16 belgili "App Password".
#    https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# EMAIL_PROVIDER=brevo uchun (kelajakda, domen ulanganda)
BREVO_API_KEY=

# Xat jo'natuvchisi. EMAIL_FROM bo'sh bo'lsa GMAIL_USER ishlatiladi.
EMAIL_FROM=
EMAIL_FROM_NAME=TradeJournal

# --------------------------------------------------------------------------
# TELEGRAM
# --------------------------------------------------------------------------

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Webhook'ni himoyalaydi: Telegram har bir so'rovda shu qiymatni
# X-Telegram-Bot-Api-Secret-Token header'ida yuboradi.
# Yaratish: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ❗ Bu qiymat o'zgarsa, scripts/setWebhook.js ni QAYTA ishga tushirish shart.
TELEGRAM_WEBHOOK_SECRET=

# Backend'ning tashqi manzili — scripts/setWebhook.js webhook URL'ini
# shundan quradi (masalan: https://trading-jurnal.onrender.com)
BACKEND_URL=

# --------------------------------------------------------------------------
# 🔒 TRUST PROXY — rate limiter uchun KRITIK
#
# Yoqilganda Express `req.ip` ni `X-Forwarded-For` header'idan oladi.
#
#   TRUST_PROXY=1   — FAQAT backend reverse proxy ortida bo'lsa (Render,
#                     Vercel, nginx). Proxy header'ni o'zi qayta yozadi.
#   bo'sh / 0       — backend to'g'ridan-to'g'ri ochiq bo'lsa (lokal ish).
#
# ❗ Proxy yo'q joyda yoqilsa, har kim soxta X-Forwarded-For yuborib har
#   so'rovda yangi "IP" ko'rsatadi va rate limiter'ni butunlay chetlab
#   o'tadi (cheksiz parol brute force).
#
# Bo'sh qoldirilsa NODE_ENV=production bo'lganda avtomatik yoqiladi.
# Lokalda bo'sh qoldiring.
# --------------------------------------------------------------------------
TRUST_PROXY=

# --------------------------------------------------------------------------
# ❗ Quyidagilar KODDA ISHLATILMAYDI (passport/express-session 2-bosqichda
#    olib tashlangan). Agar lokal .env faylingizda qolgan bo'lsa, o'chirib
#    tashlashingiz mumkin — hech narsaga ta'sir qilmaydi:
#      GOOGLE_CLIENT_SECRET, GOOGLE_CALLBACK_URL, SESSION_SECRET, FRONTEND_URL
#
#    Google Sign-In faqat GOOGLE_CLIENT_ID talab qiladi: ID token frontendda
#    olinadi, backend uni audience bo'yicha tekshiradi. Redirect/callback
#    oqimi ishlatilmaydi.
# --------------------------------------------------------------------------

# --------------------------------------------------------------------------
# DNS — FAQAT LOKAL ISH UCHUN (ixtiyoriy)
#
# mongodb+srv:// manzili SRV yozuvini yechishni talab qiladi. Ba'zi
# provayderlarning DNS serverlari SRV so'rovlariga javob bermaydi va
# "querySrv ENOTFOUND" xatosi chiqadi. Shu holatda quyidagini yoqing:
#
#   DNS_SERVERS=8.8.8.8,1.1.1.1
#
# ❗ Render'da (production'da) bu o'zgaruvchini QO'YMANG — u yerda tizim
#   DNS'i to'g'ri ishlaydi va o'zgaruvchi bo'lmasa hech narsa o'zgarmaydi.
# --------------------------------------------------------------------------
DNS_SERVERS=
